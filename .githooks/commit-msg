#!/usr/bin/env bash
msg_file="$1"
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9_-]+\))?(!)?: .{1,72}$'

first_line=$(head -n1 "$msg_file")

# Allow merge and revert commits
if echo "$first_line" | grep -qE '^(Merge|Revert)'; then exit 0; fi

if ! echo "$first_line" | grep -qE "$pattern"; then
  echo "Invalid commit message."
  echo "Expected: type(scope): description"
  echo "Types: feat fix docs style refactor perf test build ci chore revert"
  echo "Example: feat(server): add UDP packet handler"
  exit 1
fi